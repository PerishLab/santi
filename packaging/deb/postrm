#!/bin/sh
# santi-api postrm: reload systemd after the unit file goes away. NEVER deletes
# the runtime (/home/santi/.santi) — that holds the soul's memory, the one thing
# that must survive across installs. Removal of runtime data, if ever wanted,
# is a deliberate host action, not a package side effect.
set -e

case "$1" in
remove | purge)
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
    ;;
esac

exit 0
